{
  "_comment": "SANITIZED EXAMPLE - copy to appsettings.json and fill in. appsettings.json is gitignored: NEVER commit real secrets. Production uses environment variables / Docker secrets (see appsettings.Production.json for the ${VAR} placeholders).",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "_comment": "Origins allowed to call the API with credentials. NEVER use *.",
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://192.168.10.151"
    ]
  },
  "DocumentsPath": "\\\\<nas-host>\\<share>\\IntranetDocuments",
  "NasSettings": {
    "Host": "<nas-host>",
    "ShareName": "<share>",
    "SubFolder": "IntranetDocuments",
    "Username": "<nas-user>",
    "Password": "<nas-password>"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=ProjectTrackerDB;User Id=sa;Password=<sql-password>;TrustServerCertificate=true;Max Pool Size=100;Min Pool Size=5;Connection Timeout=30;",
    "AzureConnection": "<azure-sql-connection-string>"
  },
  "JwtSettings": {
    "_comment": "SecretKey is REQUIRED - the app refuses to start without it. Generate a strong random 64+ char value, e.g.: openssl rand -base64 64",
    "SecretKey": "<generate-a-strong-random-key>",
    "Issuer": "ProjectTrackerAPI",
    "Audience": "ProjectTrackerClient"
  },
  "Portal": {
    "_comment": "Rocket Freight client portal (/api/portal). Add the portal domain to Cors:AllowedOrigins too. Audience defaults to '<JwtSettings:Audience>-portal' so portal tokens never work on intranet endpoints. Tracking links (portal + waybill QR) use Shipments:PortalBaseUrl.",
    "PublicUrl": "https://portal.rocketfreight.co.za",
    "PublicApiBase": "https://api.rocketfreight.co.za",
    "TokenHours": 12,
    "SupportHours": "Mon–Fri 07:00–17:00",
    "SupportOpenHour": 7,
    "SupportCloseHour": 17
  },
  "CarTrack": {
    "BaseUrl": "https://fleetapi-za.cartrack.com/rest/",
    "Username": "<cartrack-user>",
    "Password": "<cartrack-api-key>",
    "TimeoutSeconds": 30,
    "Region": "South Africa"
  },
  "SchoolDelivery": {
    "Enabled": true,
    "TimeoutSeconds": 30,
    "Regions": {
      "WC": { "Name": "Western Cape", "BaseUrl": "<wc-base-url>", "Username": "", "Password": "" },
      "KZN": { "Name": "KwaZulu-Natal", "BaseUrl": "<kzn-base-url>", "Username": "", "Password": "" },
      "EC": { "Name": "Eastern Cape", "BaseUrl": "<ec-base-url>", "Username": "", "Password": "" }
    }
  },
  "TFN": {
    "BaseUrl": "https://api.tfn.co.za",
    "Username": "<tfn-user>",
    "Password": "<tfn-password>",
    "CustomerNumber": "<tfn-customer-no>",
    "ApiVersion": "2.0",
    "TimeoutSeconds": 30,
    "SyncIntervalMinutes": 15,
    "AutoSync": { "Enabled": true, "IntervalMinutes": 15 }
  },
  "Claude": { "ApiKey": "<anthropic-api-key>", "Model": "claude-sonnet-4-20250514", "Enabled": true },
  "LocalLlm": { "BaseUrl": "http://localhost:8090", "Model": "<model-name>", "Enabled": true },
  "GoogleMaps": { "ApiKey": "<google-maps-api-key>" },
  "SearXNG": { "BaseUrl": "http://localhost:8888" },
  "GeminiSettings": { "ApiKey": "<gemini-api-key>" },
  "EmailEnabled": true,
  "AzureSync": { "Enabled": false },
  "ClockingDevice": {
    "ApiKey": "<strong-random-device-key>",
    "Notes": "Set the same key as X-Device-Key header in the clocking machine software."
  },
  "Email": {
    "SmtpHost": "<smtp-host>",
    "SmtpPort": 465,
    "SenderEmail": "<sender-email>",
    "SenderName": "ProMed Intranet",
    "SenderPassword": "<smtp-password>",
    "EnableSsl": true,
    "UseDefaultCredentials": false
  },
  "FallbackEmail": {
    "SmtpHost": "<smtp-host>",
    "SmtpPort": 465,
    "SenderEmail": "<sender-email>",
    "SenderName": "ProMed Intranet",
    "SenderPassword": "<smtp-password>",
    "EnableSsl": true
  },
  "IntranetEmail": {
    "SmtpHost": "<smtp-host>",
    "SmtpPort": 465,
    "SenderEmail": "<sender-email>",
    "SenderName": "ProMed Intranet",
    "SenderPassword": "<smtp-password>",
    "EnableSsl": true,
    "ImapHost": "<imap-host>",
    "ImapPort": 993,
    "ImapUseSsl": true
  },
  "HBA1C": {
    "BaseUrl": "<hba1c-api-base-url>",
    "Email": "<hba1c-user>",
    "Password": "<hba1c-password>",
    "TimeoutSeconds": 30
  },
  "AIEmail": {
    "SmtpHost": "<smtp-host>",
    "SmtpPort": 465,
    "SenderEmail": "<ai-sender-email>",
    "SenderName": "Welly - ProMed AI Assistant",
    "SenderPassword": "<smtp-password>",
    "EnableSsl": true,
    "UseDefaultCredentials": false
  },
  "ImapSettings": {
    "Host": "<imap-host>",
    "Port": 993,
    "UseSsl": true,
    "TimeoutSeconds": 15
  },
  "SalesMonitor": {
    "Enabled": true,
    "KeepAliveMinutes": 9,
    "StaggerSeconds": 3,
    "MaxAuthFailures": 2,
    "MinBackoffSeconds": 60,
    "MaxBackoffSeconds": 1800,
    "Mailboxes": [ "<mailbox1>", "<mailbox2>" ]
  },
  "DocumentPasswords": {
    "Default": "<pin>",
    "Paperless": "<pin>"
  }
}
