# --- MCP Logistics connector configuration -------------------------------
# Copy this file to ".env" and fill in real values. Do NOT commit .env.

# Public HTTPS URL that Claude will reach (your Cloudflare Tunnel hostname).
PUBLIC_URL=https://logistics-mcp.example.com

# Strong password users must type on the Claude authorization screen.
ACCESS_PASSWORD=please-set-a-long-random-password

# Database connection (defaults target the docker-compose SQL container).
DB_SERVER=database
DB_PORT=1433
DB_NAME=ProjectTrackerDB
DB_USER=sa
DB_PASSWORD=YourStrong@Passw0rd

# Cloudflare Tunnel token (from `cloudflared tunnel` / dashboard).
TUNNEL_TOKEN=
