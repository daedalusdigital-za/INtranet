# --- MCP Logistics connector configuration -------------------------------
# Copy this file to ".env" and fill in real values. Do NOT commit .env.

# Public HTTPS URL that Claude will reach (your Cloudflare Tunnel hostname).
PUBLIC_URL=https://logistics-mcp.example.com

# REQUIRED. Password users must type on the Claude authorization screen.
# The server refuses to start if this is unset, shorter than 12 characters,
# or a placeholder (e.g. the value below). Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# (docker-compose reads MCP_ACCESS_PASSWORD from the root .env instead.)
ACCESS_PASSWORD=please-set-a-long-random-password

# Optional. Extra OAuth redirect URIs that dynamically-registered clients may use,
# as comma-separated https:// URL prefixes. Claude's own callbacks
# (https://claude.ai/api/mcp/auth_callback, https://claude.com/api/mcp/auth_callback)
# and loopback http://localhost:<port>/ / http://127.0.0.1:<port>/ are always allowed.
ALLOWED_REDIRECT_URIS=

# Database connection (defaults target the docker-compose SQL container).
# Use the least-privilege read-only login from Database/CreateMcpReadonlyViews.sql.
DB_SERVER=database
DB_PORT=1433
DB_NAME=ProjectTrackerDB
DB_USER=mcp_readonly
DB_PASSWORD=set-to-the-mcp_readonly-login-password

# Cloudflare Tunnel token (from `cloudflared tunnel` / dashboard).
TUNNEL_TOKEN=
